{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-ec2-terminate.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/aws-cost-tripwire.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/git-safety-guard.js"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/aws-cost-tripwire.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
