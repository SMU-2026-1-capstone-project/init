# 이 파일을 .env로 복사한 후 자기 환경에 맞게 값을 채우세요.
# .env는 .gitignore에 등록되어 git에 올라가지 않습니다.
#
# cp .env.example .env

# ===========================================
# [MySQL 컨테이너 설정] - docker-compose.yml에서 사용
# ===========================================
MYSQL_DATABASE=shadowfit
MYSQL_USER=shadowfit

# ↓ 비밀번호는 자기 로컬 환경에 맞게 직접 입력. 운영에서는 강력한 값 사용.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# 호스트(내 PC)에서 노출할 포트.
# 기본값 3306. 다른 MySQL이 이미 3306을 쓰고 있으면 3308 등으로 바꾸세요.
# 컨테이너 내부는 항상 3306이라 이 포트만 바뀝니다.
MYSQL_PORT=3306

# ===========================================
# [Spring Backend - DB 접속] - application.yml에서 사용
# ===========================================
DB_USERNAME=shadowfit

# ↓ MYSQL_PASSWORD와 같은 값으로 입력
DB_PASSWORD=CHANGE_ME

# 백엔드를 도커 컨테이너로 띄우면 아래 두 줄은 비워두거나 주석.
# (yml 기본값 shadowfit-mysql:3306 이 도커 네트워크에서 자동 해석됨)
#
# 백엔드를 PowerShell의 .\gradlew.bat bootRun 으로 직접 실행할 때만 아래 두 줄 사용.
# DB_PORT는 위의 MYSQL_PORT와 같은 값.
DB_HOST=localhost
DB_PORT=3306

# ===========================================
# [JWT] - application.yml에서 사용
# ===========================================
# 반드시 Base64 호환 문자열(A-Z, a-z, 0-9, +, /, =). 하이픈(-) 사용 금지.
# 디코딩 후 32바이트(=256bit) 이상이어야 HMAC-SHA256 키 길이 충족.
#
# 생성 방법:
#   bash:       openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((New-Guid).ToString() + (New-Guid).ToString()))
#
# 절대 이 placeholder 값을 그대로 사용하지 말 것! 모두가 같은 시크릿을 쓰면 위조 가능.
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_STRING_AT_LEAST_32_BYTES_DECODED

# 토큰 만료 시간(**초**). 기본 access 30분 / refresh 7일.
#   ⚠️ 주석이 «ms, 기본 1시간» 이라고 적혀 있었는데 둘 다 틀렸다 — JwtUtil 은 plusSeconds 로
#      쓰고, 옛 기본값 86400 은 1시간이 아니라 24시간이었다.
#   access 30분은 측정값이 아니라 약속이다. 로그아웃 후 access 가 살아 있는 최대 구간이
#   곧 이 값이다 (블랙리스트 폐지, decisions/token-lifecycle.md §3-0-2).
JWT_EXPIRATION_TIME=1800
JWT_REFRESH_EXPIRATION_TIME=604800

# ===========================================
# [내부 API 토큰]
# ===========================================
# Spring <-> AI 서버 간 내부 호출 검증용 (gRPC 양방향). 무작위 문자열로 생성하여
# 양쪽 서버에 동일 값 입력.
# ⚠️ 이 값은 **서버 밖으로 내보내지 말 것** — 프론트에 넣으면 앱 번들에서 추출돼
#    Spring 내부 gRPC 까지 뚫린다 (이슈 #134).
INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_SECRET

# 프론트 -> AI 서버 HTTP 직결(분기 H2) 전용 토큰. 위 값과 **다른** 무작위 문자열.
# 앱 번들에 인라인되는 값이므로 비밀이 아니다 — 유출 피해를 AI HTTP 로 한정하는 것이 목적.
# 프론트는 같은 값을 EXPO_PUBLIC_AI_PUBLIC_TOKEN 으로 갖는다 (frontend/.env).
AI_PUBLIC_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

# ===========================================
# [AI 서버 / gRPC]
# ===========================================
# 🔴 AI 컨테이너 메모리 한도. **운영(docker-compose.prod.yml)에서는 필수** — 그 파일의
#    `${AI_MEM_LIMIT:?…}` 가 값이 없으면 **`up` 을 컨테이너 생성 전에 멈춘다.**
#    ⚠️ compose 를 안 거치고 띄우면(직접 `docker run`, k8s 등) 더 나쁘게 실패한다 —
#    `up`·헬스체크는 통과하고 **첫 운동 세션에서 죽는다** (#214). 검출기 풀이 이 값에서
#    크기를 유도하기 때문이다(`ai-server/app/core/mediapipe_detector.py:285-293`).
#    유도식(실측): 한도 = 기본 RSS 100.5MB + 검출기 98.7MB × 동시 세션 수
#    🔴 **딱 맞추지 말고 여유를 둘 것** — 이 공식은 «검출기만» 센다. 프레임 버퍼·base64
#       임시·파이썬 힙·gRPC 는 **미측정이라 안 들어갔다**(`memory_ceiling()` 자신의 경고).
#       딱 맞추면 풀이 세션을 거절하기 전에 컨테이너가 OOM 으로 죽는다. 여유를 «몇 %» 로
#       할지는 근거가 없어 여기 안 적는다 — 재려면 #229
#      로컬(물리 2코어) 1536m — CPU 가 ~6세션에서 먼저 막으므로 더 줘도 못 쓴다
#      c7i.2xlarge      6656m — 물리 4코어 CPU 상한 65세션 기준. ⚠️ 미검증 준비값
#    실패 방향: 작게 주면 «세션이 덜 받아짐»(돌긴 한다), 크게 주면 «안 뜸».
AI_MEM_LIMIT=1536m
# 검출기 풀 크기. 0 = 위 한도에서 유도(권장). 한도를 못 거는 배포 형태에서만 직접 지정한다.
POSE_DETECTOR_POOL_SIZE=0

# 도커로 띄우면 아래 값들은 비워두거나 주석. (yml 기본값이 도커 네트워크 호스트명)
# 로컬에서 uvicorn으로 띄울 때만 사용.

# Spring→AI gRPC 주소. application.yml 의 fastapi-client.address 가 이 둘을 조립한다 (#285).
# 예전엔 이 자리에 GRPC_FASTAPI_ADDRESS=static://localhost:50051 이 있었는데, 읽는 코드가
# 없었고 **포트도 틀렸다** — AI 의 실제 gRPC 포트는 8585 다(ai-server/app/config.py AI_GRPC_PORT).
# compose 는 이 값을 안 본다. 거기선 environment 블록이 shadowfit-ai:8585 를 직접 넣는다.
AI_SERVER_HOST=localhost
AI_SERVER_GRPC_PORT=8585

# ===========================================
# [선택] OpenAI API
# ===========================================
OPENAI_API_KEY=

# ===========================================
# [관측 스택] — docker compose --profile obs 로 띄울 때만 필요
# ===========================================
# mysqld_exporter 가 MySQL 에 붙을 때 쓰는 전용 계정의 비밀번호.
# 앱 계정(MYSQL_PASSWORD)과 다른 값이어야 한다 — 필요 권한이 교집합 없이 갈린다
# (PROCESS·REPLICATION CLIENT·performance_schema SELECT vs DML).
#
# 🔴 이 값을 바꾸면 **계정도 같이 맞춰야 한다**. 값이 두 곳(compose·MySQL 계정)에서
#    쓰이는데 계정은 별도 파일로 만들기 때문이다 (#167):
#      set -a; . ./.env; set +a
#      ./mysql/apply-exporter-user.sh
#    안 맞추면 익스포터 타깃이 DOWN 이 되고, 증상은 «MySQL 지표만 통째로 빔» 이라
#    알아채기 어렵다. compose 에 기본값을 두지 않은 이유가 그것이다 — 미설정이면
#    obs 프로파일이 즉시 실패한다.
MYSQL_EXPORTER_PASSWORD=CHANGE_ME

# Grafana 관리자 계정. 미설정이면 admin/admin 으로 뜬다(compose 기본값).
# 익스포터와 달리 계정을 컨테이너가 스스로 만들어 한 곳에서 끝나므로 어긋날 자리가 없다.
# 콘솔은 127.0.0.1 에만 바인딩된다(#128) — 그래도 기본값으로 두지 말 것.
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# ===========================================
# [리버스 프록시] — 프록시를 실제로 앞에 세운 뒤에만 건드린다
# ===========================================
# Spring 이 X-Forwarded-Proto·X-Forwarded-For 를 믿을지 (application-prod.yml).
#
# 🔴 **기본값 none 을 그대로 두는 것이 지금은 옳다.** framework 로 켜면 Spring 은 요청이
#    들고 온 그 헤더들을 **그대로 믿는다.** 앞에 프록시가 없으면(= 지금 이 저장소 상태)
#    아무나 자기 클라이언트 IP 와 스킴을 위조할 수 있다.
#
# ✅ framework 로 바꿔야 할 때: 프록시(nginx/Caddy/ALB/CF Tunnel)를 실제로 세웠고,
#    그 프록시가 이 헤더들을 **자기가 덮어쓰도록** 설정돼 있을 때.
#    안 켜면 프록시 뒤에서 ① 리다이렉트·절대 URL 이 http 로 생기고 ② 접근 로그의
#    클라이언트 IP 가 전부 프록시 IP 하나로 찍힌다 — 둘 다 «돌긴 도는데 조용히 틀린» 부류다.
#
# ⚠️ 이 값은 **개발 환경에도 적용된다.** docker-compose.yml(개발용)도 prod 프로파일로 뜨고
#    로컬 bootRun 도 그렇다 (docs/decisions/reverse-proxy-and-tls.md §8-2).
#
# 선택지: none(기본) | framework | native
# FORWARD_HEADERS_STRATEGY=none
