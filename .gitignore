/mysql/data/

# 환경 변수 파일 제외 (보안)
.env

# 빌드 결과물 제외
/build/
/out/
.gradle/

# 프론트 소스는 추적. node_modules/.expo/빌드물은 frontend/.gitignore 가 제외함.
.agents/
.backup-presync/

# loadtest 시딩 산출물 (gen_pose_template.py 출력, ~1.3MB)
loadtest/seed/template.sql
