{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListForSync",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "WriteResults",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::__BUCKET__/__PREFIX__/*"
    }
  ]
}